{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": [
        "rdoc",
        "puma",
        "psych",
        "diff-lcs",
        "nio4r"
      ]
    },
    {
      "groupName": "SimpleCov coverage",
      "matchPackageNames": [
        "simplecov",
        "simplecov-cobertura"
      ]
    }
  ],
  "platformAutomerge": false
}
